# CoinX 环境变量模板
# 加载顺序：进程环境变量 > .env.<profile> > .env > 代码默认值
# 选择环境：COINX_ENV=local 或 COINX_ENV=prod
# 修改环境变量后需要重启应用才能生效。
# 密码、密钥和代理凭据建议通过进程环境变量、Docker Secret 或 Secret Manager 注入。
#
# 以下按功能分组；不需要的后端、代理池和密钥项保持注释即可。
# 应用运行配置与 Docker、测试、工具配置分开，便于日常查找。

# ================================================================
# 00. 环境与实例
# ================================================================
# Active profile: local, prod, or another file name matching .env.<profile>
# COINX_ENV=local

# 双实例运行时区分进程和日志。
# INSTANCE_NAME=mysql

# 应用日志文件路径；未设置时使用 logs/app.log。
# APP_LOG_FILE=logs/app.log

# 01. Web 服务
# ================================================================
# 服务监听地址；生产环境通常保持 0.0.0.0。
WEB_HOST=0.0.0.0
# 服务监听端口；类型：整数；默认：5500。
WEB_PORT=5500
# 是否启用调试模式；生产环境必须为 false。
WEB_DEBUG=false

# 02. 登录与认证
# ================================================================
# 登录用户名。
WEB_USERNAME=admin
# 登录密码；敏感配置，不要提交到 Git。
# WEB_PASSWORD=
# 是否关闭登录校验；仅建议本地开发使用。
WEB_AUTH_DISABLED=false

# JWT 认证配置
# JWT 签名密钥；生产环境必须设置固定值。
# WEB_JWT_SECRET_KEY=
# Access Token 有效期，单位：分钟；默认：1440。
WEB_JWT_ACCESS_TOKEN_EXPIRES_MINUTES=1440
# Refresh Token 有效期，单位：天；默认：30。
WEB_JWT_REFRESH_TOKEN_EXPIRES_DAYS=30
# 是否为 Cookie 设置 Secure 属性；HTTPS 环境应设置为 true。
WEB_JWT_COOKIE_SECURE=false
# JWT Cookie 绑定的域名；跨子域共享 Cookie 时配置。
# WEB_JWT_COOKIE_DOMAIN=

# 03. 调度器与采集总开关
# ================================================================
# 是否启用定时任务调度器；设为 false 时仍保留任务定义和手动执行入口。
SCHEDULER_ENABLED=true
# true：仅允许定时任务采集；false：页面和手动接口也可以采集。
COLLECTION_SCHEDULER_ONLY=true
# 常规数据更新间隔，单位：秒。
UPDATE_INTERVAL=300
# 需要采集的时间周期，多个值用英文逗号分隔。
TIME_INTERVALS=5m,15m,30m,1h,4h,12h,24h,48h,72h,168h

# 04. 首页与市场数据
# ================================================================
# 参与首页数据累计的交易所，多个值用英文逗号分隔。
ENABLED_EXCHANGES=binance,okx,bybit,gate
# 首页价格参考交易所；价格不累计，仅使用该交易所的 K 线价格。
PRIMARY_PRICE_EXCHANGE=binance
# 首页需要维护的数据序列类型，多个值用英文逗号分隔。
HOMEPAGE_SERIES_TYPES=klines,open_interest_hist,taker_buy_sell_vol
# 是否启用首页历史序列补采。
HOMEPAGE_SERIES_REPAIR_ENABLED=true
# 首页补采的基础周期。
HOMEPAGE_SERIES_REPAIR_PERIOD=5m
# 每次补采请求的最大数据条数。
HOMEPAGE_SERIES_REPAIR_PAGE_LIMIT=500
# 首页数据窗口健康度阈值，单位：百分比。
HOMEPAGE_WINDOW_HEALTH_THRESHOLD=95

# 05. 交易所连接与请求限制
# ================================================================
# Binance API 地址。
BINANCE_BASE_URL=https://fapi.binance.com
# OKX API 地址。
OKX_BASE_URL=https://www.okx.com
# OKX Rubik 接口最小请求间隔，单位：毫秒。
OKX_RUBIK_MIN_INTERVAL_MS=500
# OKX 返回 429 时的备用等待时间，单位：秒。
OKX_429_RETRY_FALLBACK_SECONDS=5
# Bybit API 地址。
BYBIT_BASE_URL=https://api.bybit.com
# Bybit 合约类型；常用值：linear、inverse。
BYBIT_CATEGORY=linear
# Gate API 地址。
GATE_BASE_URL=https://fx-api.gateio.ws
# Gate 结算币种。
GATE_SETTLE=usdt
# Gate 请求最小间隔，单位：毫秒。
GATE_MIN_INTERVAL_MS=60
# Gate 返回 403 时的备用等待时间，单位：秒。
GATE_403_RETRY_FALLBACK_SECONDS=8

# 06. 控制面数据库
# ================================================================
# 控制面数据库类型；可选值：mysql、starrocks。
DB_TYPE=mysql
# 数据库地址。
DB_HOST=mysql
# 数据库端口。
DB_PORT=3306
# 数据库用户名。
DB_USER=coinx
# 数据库密码；敏感配置，不要提交到 Git。
# DB_PASSWORD=
# 数据库名称。
DB_NAME=coinx
# 数据库字符集。
DB_CHARSET=utf8mb4

# 外部 MySQL 导入模板；仅渲染导入 SQL 时使用。
# MYSQL_SOURCE_HOST=mysql:3306
# MYSQL_SOURCE_DATABASE=coinx
# MYSQL_SOURCE_USER=coinx
# MYSQL_SOURCE_PASSWORD=

# 07. 行情数据后端
# ================================================================
# 行情数据统一读写后端；可选值：mysql、clickhouse。
MARKET_BACKEND=mysql
# 单独指定读取后端；仅用于双后端迁移或验证。
# READ_BACKEND=
# 单独指定写入后端；仅用于双后端迁移或验证。
# MARKET_WRITE_BACKEND=

# 08. ClickHouse
# ================================================================
# ClickHouse HTTP 地址；MARKET_BACKEND=clickhouse 时必须配置。
# CLICKHOUSE_URL=http://clickhouse:8123
# ClickHouse 数据库名称。
# CLICKHOUSE_DATABASE=coinx
# ClickHouse 用户名。
# CLICKHOUSE_USER=default
# ClickHouse 密码；敏感配置，不要提交到 Git。
# CLICKHOUSE_PASSWORD=
# 是否启用 MySQL 与 ClickHouse 影子读对比。
# CLICKHOUSE_READ_SHADOW=false
# ClickHouse 读请求超时时间，单位：秒。
# CLICKHOUSE_READ_TIMEOUT_SECONDS=120
# 单条查询使用的最大线程数。
# CLICKHOUSE_QUERY_MAX_THREADS=2
# 首页并行查询的最大 Worker 数。
# CLICKHOUSE_HOMEPAGE_MAX_WORKERS=2
# 进程内同时执行的最大 ClickHouse 查询数。
# CLICKHOUSE_MAX_CONCURRENT_QUERIES=2
# 高时间框架 K 线聚合每批处理的币种数；默认 32。
# CLICKHOUSE_AGGREGATION_SYMBOL_BATCH_SIZE=32
# 单条查询最大内存，单位：字节；0 表示使用服务端默认值。
# CLICKHOUSE_MAX_MEMORY_USAGE_BYTES=0
# ClickHouse 写请求超时时间，单位：秒。
# CLICKHOUSE_WRITE_TIMEOUT_SECONDS=120
# ClickHouse 写入失败后的重试次数。
# CLICKHOUSE_WRITE_RETRIES=3
# ClickHouse 批量写入条数。
# CLICKHOUSE_WRITE_BATCH_SIZE=500

# 09. StarRocks
# ================================================================
# DB_TYPE=starrocks 时使用；未配置的项目会回退到 DB_*。
# SR_HOST=
# SR_PORT=9030
# SR_USER=
# SR_PASSWORD=
# SR_DB=

# 10. 网络代理
# ================================================================
# 是否启用单一 HTTP 代理。
USE_PROXY=false
# 单一代理主机和端口。
PROXY_HOST=127.0.0.1
PROXY_PORT=7897
# 是否启用代理池。
USE_PROXY_POOL=false
# 代理池地址；可能包含账号密码，属于敏感配置。
# 格式示例：HK=socks5h://user:password@proxy.example.com:2261
PROXY_POOL_URLS=
# 代理池轮换策略。
PROXY_POOL_STRATEGY=round_robin
# 代理失败后的冷却时间，单位：秒。
PROXY_POOL_FAIL_COOLDOWN_SECONDS=30

# 11. 币种刷新任务
# ================================================================
# 是否启用币种列表刷新任务。
FETCH_COINS_ENABLED=true
# 币种列表刷新间隔，单位：秒。
FETCH_COINS_INTERVAL=600
# 按成交量选取的币种数量。
FETCH_COINS_TOP_VOLUME_COUNT=100
# 按涨幅选取的币种数量。
FETCH_COINS_TOP_GAINERS_COUNT=25
# 按跌幅选取的币种数量。
FETCH_COINS_TOP_LOSERS_COUNT=25

# 12. 数据补采任务
# ================================================================
# 跟踪币种补采间隔，单位：秒。
REPAIR_TRACKED_INTERVAL=300
# 滚动补采点数。
REPAIR_ROLLING_POINTS=5
# 滚动补采最大并发 Worker 数。
REPAIR_ROLLING_MAX_WORKERS=6
# 滚动补采批量写入条数。
REPAIR_ROLLING_WRITE_BATCH_SIZE=500
# 是否启用历史数据补采。
REPAIR_HISTORY_ENABLED=true
# 历史数据补采间隔，单位：秒。
REPAIR_HISTORY_INTERVAL=3600
# 历史数据补采最大并发 Worker 数。
REPAIR_HISTORY_MAX_WORKERS=2
# 历史数据批量写入条数。
REPAIR_HISTORY_WRITE_BATCH_SIZE=2000
# 单次历史补采的币种批次大小；0 表示使用默认策略。
REPAIR_HISTORY_SYMBOL_BATCH_SIZE=0
# 任务运行记录保留时间，单位：天。
TASK_RUN_HISTORY_RETENTION_DAYS=90
# 历史数据目标覆盖范围，单位：小时。
REPAIR_HISTORY_COVERAGE_HOURS=168

# Binance 专属序列管理页的补采开关。
BINANCE_SERIES_REPAIR_ENABLED=false

# 13. 资金费率任务
# ================================================================
# 是否启用资金费率采集。
FUNDING_RATE_COLLECT_ENABLED=true
# 资金费率异常阈值；0.001 表示 0.1%。
FUNDING_RATE_ABNORMAL_THRESHOLD=0.001

# 14. 通知
# ================================================================
# 是否启用通知功能。
NOTIFICATIONS_ENABLED=false
# 通知配置加密主密钥；敏感配置，不要提交到 Git。
# NOTIFICATION_ENCRYPTION_KEY=
# 通知配置加密密钥版本。
NOTIFICATION_ENCRYPTION_KEY_VERSION=v1
# 通知请求超时时间，单位：秒。
NOTIFICATION_TIMEOUT_SECONDS=5

# 15. RSS
# ================================================================
# 是否启用 RSS 监控。
RSS_ENABLED=true
# RSS 轮询间隔，单位：秒。
RSS_POLL_INTERVAL=600
# RSS 请求超时时间，单位：秒。
RSS_REQUEST_TIMEOUT_SECONDS=20
# RSS 请求 User-Agent。
RSS_USER_AGENT=CoinX RSS Monitor/1.0
# RSS 专用代理基础地址；留空表示不使用。
RSS_PROXY_BASE_URL=https://proxy.yffjglcms.com

# 16. Docker、测试与工具
# ================================================================
# Docker Compose 内置 MySQL 的 root 密码；仅用于 Compose。
# MYSQL_ROOT_PASSWORD=

# 外部 MySQL 导入模板；仅渲染导入 SQL 时使用。
# MYSQL_SOURCE_HOST=mysql:3306
# MYSQL_SOURCE_DATABASE=coinx
# MYSQL_SOURCE_USER=coinx
# MYSQL_SOURCE_PASSWORD=

# Playwright 测试登录密码；未设置时使用 WEB_PASSWORD。
# COINX_TEST_WEB_PASSWORD=

# StarRocks Compose 端口映射；仅用于 Docker Compose。
# SR_FE_HTTP_PORT=8030
# SR_FE_QUERY_PORT=9030
# SR_BE_WEB_PORT=8040

# Python 依赖安装镜像源；仅在需要时配置。
# PIP_INDEX_URL=https://pypi.tuna.tsinghua.edu.cn/simple

# Docker Compose 选择使用的环境文件，例如 .env.prod。
# COINX_ENV_FILE=.env.prod
