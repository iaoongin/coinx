# 生产环境差异配置。
# 公共配置请放在 .env；本文件中的值会覆盖 .env。
# 密码、JWT 密钥和通知密钥通过进程环境变量或 Secret Manager 注入。
COINX_ENV=prod

# 生产环境关闭调试和免登录。
WEB_DEBUG=false
WEB_AUTH_DISABLED=false

# 生产环境启用自动调度，并限制为调度任务采集。
SCHEDULER_ENABLED=true
COLLECTION_SCHEDULER_ONLY=true

# 生产环境使用 ClickHouse 行情后端。
MARKET_BACKEND=clickhouse

# 生产环境 ClickHouse 资源限制。
CLICKHOUSE_QUERY_MAX_THREADS=2
CLICKHOUSE_HOMEPAGE_MAX_WORKERS=1
CLICKHOUSE_MAX_CONCURRENT_QUERIES=2
CLICKHOUSE_AGGREGATION_SYMBOL_BATCH_SIZE=32
CLICKHOUSE_MAX_MEMORY_USAGE_BYTES=1073741824
