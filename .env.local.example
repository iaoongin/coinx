# 本地开发环境差异配置。
# 公共配置请放在 .env；本文件中的值会覆盖 .env。
#
# 本地开启调试、关闭登录和自动调度，避免开发环境持续请求外部交易所。
COINX_ENV=local
WEB_DEBUG=true
WEB_AUTH_DISABLED=true
SCHEDULER_ENABLED=false
COLLECTION_SCHEDULER_ONLY=false

# 本地默认使用 MySQL 行情后端。
MARKET_BACKEND=mysql

# 降低本地 ClickHouse 资源占用。
CLICKHOUSE_READ_SHADOW=false
CLICKHOUSE_QUERY_MAX_THREADS=1
CLICKHOUSE_HOMEPAGE_MAX_WORKERS=1
CLICKHOUSE_MAX_CONCURRENT_QUERIES=1
CLICKHOUSE_MAX_MEMORY_USAGE_BYTES=1073741824
